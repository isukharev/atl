{
  "schema_version": 1,
  "hosted_schema_version": 1,
  "checks": [
    {"id":"agent-eval-build","make_target":"agent-eval-build"},
    {"id":"agent-eval-compat","make_target":"agent-eval-compat"},
    {"id":"agent-eval-contract","make_target":"agent-eval-contract"},
    {"id":"agent-eval-full","make_target":"agent-eval-full"},
    {"id":"agent-eval-lint","make_target":"agent-eval-lint"},
    {"id":"agent-eval-product-boundary","make_target":"agent-eval-product-boundary"},
    {"id":"agent-eval-race","make_target":"agent-eval-race"},
    {"id":"agent-eval-support","make_target":"check-agent-eval-support"},
    {"id":"agent-eval-tidy-check","make_target":"agent-eval-tidy-check"},
    {"id":"agent-eval-unit","make_target":"agent-eval-unit"},
    {"id":"agent-eval-vet","make_target":"agent-eval-vet"},
    {"id":"agent-eval-vuln","make_target":"agent-eval-vuln"},
    {"id":"agent-eval-windows","make_target":"agent-eval-windows"},
    {"id":"context7-docs","make_target":"check-context7-docs"},
    {"id":"corpus-devcontainer","make_target":"check-corpus-devcontainer"},
    {"id":"docs-catalog","make_target":"check-docs-catalog"},
    {"id":"docs-freshness","make_target":"check-docs-freshness"},
    {"id":"lint","make_target":"lint"},
    {"id":"maintainability","make_target":"check-maintainability"},
    {"id":"maintainer-contract","make_target":"check-maintainer-contract"},
    {"id":"onboarding-docs","make_target":"check-onboarding-docs"},
    {"id":"package-boundary","make_target":"check-package-boundary"},
    {"id":"plugins","make_target":"check-plugins"},
    {"id":"reference-split","make_target":"check-reference-split"},
    {"id":"repository-skills","make_target":"check-repository-skills"},
    {"id":"skill-routing","make_target":"check-skill-routing"},
    {"id":"test","make_target":"test"},
    {"id":"vet","make_target":"vet"}
  ],
  "rules": [
    {"path":".editorconfig","checks":["test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"path":".env.integration.example","checks":["docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":".gitattributes","checks":["docs-freshness","maintainer-contract"],"hosted_lanes":["contracts"]},
    {"path":".github/workflows/ci.yml","checks":["corpus-devcontainer"],"hosted_lanes":["contracts","corpus"]},
    {"path":".gitignore","checks":["test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"path":".golangci.yml","checks":["lint"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":".mcp.json","checks":["plugins"],"hosted_lanes":["contracts","eval-compat"]},
    {"path":"AGENTS.md","checks":["docs-catalog","docs-freshness","maintainer-contract","repository-skills"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"CHANGELOG.md","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"CLAUDE.md","checks":["docs-catalog","maintainer-contract","repository-skills"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"CONTRIBUTING.md","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"LICENSE","checks":["docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"Makefile","checks":["agent-eval-full","agent-eval-support","docs-freshness","maintainability","maintainer-contract","test"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"NOTICE","checks":["docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"README.md","checks":["context7-docs","docs-catalog","onboarding-docs"],"hosted_lanes":["contracts"]},
    {"path":"README.ru.md","checks":["context7-docs","docs-catalog","onboarding-docs"],"hosted_lanes":["contracts"]},
    {"path":"ROADMAP.md","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"SECURITY.md","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"STANDARDS.md","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"VERSION","checks":["maintainer-contract"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"context7.json","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"path":"docs/command-coverage.v1.json","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"path":"docs/jira-guarded-writeback.md","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"path":"docs/maintainability-ratchets.v1.json","checks":["maintainability"],"hosted_lanes":["contracts"]},
    {"path":"docs/maintainer-impact.v1.json","checks":["docs-freshness"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"docs/maintainers/agent-eval-distribution.md","checks":["test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"path":"docs/maintainers/agent-eval-support.md","checks":["agent-eval-support"],"hosted_lanes":["contracts"]},
    {"path":"docs/maintainers/agent-eval-support.v1.json","checks":["agent-eval-support"],"hosted_lanes":["contracts"]},
    {"path":"docs/plugins.md","checks":["docs-freshness","plugins","repository-skills"],"hosted_lanes":["contracts","eval-compat"]},
    {"path":"docs/safe-writes.md","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"path":"go.mod","checks":["agent-eval-product-boundary","lint","maintainer-contract","test","vet"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"go.sum","checks":["agent-eval-product-boundary","lint","test","vet"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"path":"install.sh","checks":["test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"path":"internal/agenteval/Makefile","checks":["agent-eval-full","maintainability","maintainer-contract"],"hosted_lanes":["contracts","eval-full","platform","security"]},
    {"path":"skills-src/routing.v1.json","checks":["docs-freshness","plugins","skill-routing"],"hosted_lanes":["contracts","eval-compat"]},
    {"prefix":".agents/","checks":["docs-catalog","repository-skills"],"hosted_lanes":["contracts"]},
    {"prefix":".claude-plugin/","checks":["plugins"],"hosted_lanes":["contracts","eval-compat"]},
    {"prefix":".devcontainer/","checks":["test"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"prefix":".github/","checks":["maintainer-contract"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"prefix":"benchmarks/","checks":["agent-eval-full"],"hosted_lanes":["contracts","eval-full","platform","security"]},
    {"prefix":"cmd/","checks":["lint","package-boundary","test","vet"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"docs/","checks":["context7-docs","docs-catalog"],"hosted_lanes":["contracts"]},
    {"prefix":"docs/maintainers/","checks":["docs-freshness","repository-skills"],"hosted_lanes":["contracts"]},
    {"prefix":"docs/reference/agent-eval/","checks":["agent-eval-contract","docs-freshness"],"hosted_lanes":["contracts","eval-full","platform","security"]},
    {"prefix":"docs/reference/cli/","checks":["docs-freshness","onboarding-docs","reference-split","skill-routing"],"hosted_lanes":["contracts"]},
    {"prefix":"docs/reference/output/","checks":["reference-split","skill-routing"],"hosted_lanes":["contracts"]},
    {"prefix":"docs/schemas/","checks":["lint","test","vet"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"examples/broker-local/","checks":["context7-docs","docs-catalog","onboarding-docs","test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"examples/corpus-devcontainer/","checks":["corpus-devcontainer","docs-catalog"],"hosted_lanes":["contracts","corpus"]},
    {"prefix":"hooks/","checks":["test"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"internal/","exclude_prefixes":["internal/agenteval/"],"checks":["lint","maintainability","package-boundary","test","vet"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"internal/agenteval/","checks":["agent-eval-full","agent-eval-product-boundary","maintainability"],"hosted_lanes":["contracts","eval-full","platform","security"]},
    {"prefix":"internal/agenteval/cmd/agent-eval/","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"prefix":"internal/agenteval/interchange/agentskills/","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"prefix":"internal/cli/","checks":["docs-freshness","onboarding-docs","skill-routing"],"hosted_lanes":["contracts"]},
    {"prefix":"internal/contentpolicy/","checks":["lint","maintainability","package-boundary","test","vet"],"hosted_lanes":["contracts","eval-compat","product","security"]},
    {"prefix":"plugins/","checks":["plugins"],"hosted_lanes":["contracts","eval-compat"]},
    {"prefix":"scripts/","checks":["lint","maintainability","test","vet"],"hosted_lanes":["contracts","corpus","eval-compat","eval-full","platform","product","security"]},
    {"prefix":"scripts/agent-eval-distribution/","checks":["agent-eval-full","agent-eval-product-boundary","docs-freshness","lint","maintainability","maintainer-contract","test","vet"],"hosted_lanes":["contracts","eval-compat","eval-full","platform","product","security"]},
    {"prefix":"scripts/check-agent-eval-support/","checks":["agent-eval-support"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-corpus-devcontainer/","checks":["corpus-devcontainer"],"hosted_lanes":["contracts","corpus"]},
    {"prefix":"scripts/check-docs-catalog/","checks":["docs-catalog"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-docs-freshness/","checks":["docs-freshness"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-maintainability/","checks":["maintainability"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-maintainer-contract/","checks":["maintainer-contract"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-module-boundary/","checks":["package-boundary"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/check-repository-skills/","checks":["repository-skills"],"hosted_lanes":["contracts"]},
    {"prefix":"scripts/gen-plugins/","checks":["docs-freshness","plugins"],"hosted_lanes":["contracts","eval-compat"]},
    {"prefix":"skills-src/","checks":["docs-catalog","plugins","skill-routing"],"hosted_lanes":["contracts","eval-compat"]},
    {"prefix":"skills/","checks":["plugins"],"hosted_lanes":["contracts","eval-compat"]}
  ]
}
