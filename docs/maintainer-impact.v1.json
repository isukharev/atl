{
  "schema_version": 1,
  "checks": [
    {"id":"agent-eval-contract","make_target":"agent-eval-contract"},
    {"id":"context7-docs","make_target":"check-context7-docs"},
    {"id":"docs-catalog","make_target":"check-docs-catalog"},
    {"id":"docs-freshness","make_target":"check-docs-freshness"},
    {"id":"lint","make_target":"lint"},
    {"id":"maintainer-contract","make_target":"check-maintainer-contract"},
    {"id":"onboarding-docs","make_target":"check-onboarding-docs"},
    {"id":"package-boundary","make_target":"check-package-boundary"},
    {"id":"plugins","make_target":"check-plugins"},
    {"id":"reference-split","make_target":"check-reference-split"},
    {"id":"repository-skills","make_target":"check-repository-skills"},
    {"id":"skill-routing","make_target":"check-skill-routing"},
    {"id":"test","make_target":"test"},
    {"id":"vet","make_target":"vet"}
  ],
  "rules": [
    {"path":".editorconfig","checks":["test"]},
    {"path":".env.integration.example","checks":["docs-catalog"]},
    {"path":".gitignore","checks":["test"]},
    {"path":".golangci.yml","checks":["lint"]},
    {"path":".mcp.json","checks":["plugins"]},
    {"path":"AGENTS.md","checks":["docs-catalog","docs-freshness","maintainer-contract","repository-skills"]},
    {"path":"CHANGELOG.md","checks":["context7-docs","docs-catalog"]},
    {"path":"CLAUDE.md","checks":["docs-catalog","maintainer-contract","repository-skills"]},
    {"path":"CONTRIBUTING.md","checks":["context7-docs","docs-catalog"]},
    {"path":"LICENSE","checks":["docs-catalog"]},
    {"path":"Makefile","checks":["docs-freshness","maintainer-contract","test"]},
    {"path":"NOTICE","checks":["docs-catalog"]},
    {"path":"README.md","checks":["context7-docs","docs-catalog","onboarding-docs"]},
    {"path":"README.ru.md","checks":["context7-docs","docs-catalog","onboarding-docs"]},
    {"path":"ROADMAP.md","checks":["context7-docs","docs-catalog"]},
    {"path":"SECURITY.md","checks":["context7-docs","docs-catalog"]},
    {"path":"STANDARDS.md","checks":["context7-docs","docs-catalog"]},
    {"path":"VERSION","checks":["maintainer-contract"]},
    {"path":"context7.json","checks":["context7-docs","docs-catalog"]},
    {"path":"docs/command-coverage.v1.json","checks":["docs-freshness"]},
    {"path":"docs/jira-guarded-writeback.md","checks":["docs-freshness"]},
    {"path":"docs/maintainer-impact.v1.json","checks":["docs-freshness"]},
    {"path":"docs/plugins.md","checks":["docs-freshness","plugins","repository-skills"]},
    {"path":"docs/safe-writes.md","checks":["docs-freshness"]},
    {"path":"go.mod","checks":["lint","maintainer-contract","test","vet"]},
    {"path":"go.sum","checks":["lint","test","vet"]},
    {"path":"install.sh","checks":["test"]},
    {"path":"skills-src/routing.v1.json","checks":["docs-freshness","plugins","skill-routing"]},
    {"prefix":".agents/","checks":["docs-catalog","repository-skills"]},
    {"prefix":".claude-plugin/","checks":["plugins"]},
    {"prefix":".devcontainer/","checks":["test"]},
    {"prefix":".github/","checks":["maintainer-contract"]},
    {"prefix":"benchmarks/","checks":["agent-eval-contract"]},
    {"prefix":"cmd/","checks":["lint","package-boundary","test","vet"]},
    {"prefix":"docs/","checks":["context7-docs","docs-catalog"]},
    {"prefix":"docs/maintainers/","checks":["docs-freshness","repository-skills"]},
    {"prefix":"docs/reference/cli/","checks":["docs-freshness","onboarding-docs","reference-split","skill-routing"]},
    {"prefix":"docs/reference/output/","checks":["reference-split","skill-routing"]},
    {"prefix":"hooks/","checks":["test"]},
    {"prefix":"internal/","checks":["lint","package-boundary","test","vet"]},
    {"prefix":"internal/cli/","checks":["docs-freshness","onboarding-docs","skill-routing"]},
    {"prefix":"plugins/","checks":["plugins"]},
    {"prefix":"scripts/","checks":["lint","test","vet"]},
    {"prefix":"scripts/check-docs-freshness/","checks":["docs-freshness"]},
    {"prefix":"scripts/check-maintainer-contract/","checks":["maintainer-contract"]},
    {"prefix":"scripts/check-repository-skills/","checks":["repository-skills"]},
    {"prefix":"scripts/gen-plugins/","checks":["docs-freshness","plugins"]},
    {"prefix":"skills-src/","checks":["docs-catalog","plugins","skill-routing"]},
    {"prefix":"skills/","checks":["plugins"]}
  ]
}
