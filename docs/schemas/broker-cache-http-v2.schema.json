{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/isukharev/atl/docs/schemas/broker-cache-http-v2.schema.json",
  "title":"ATL Broker cache qualification HTTP v2",
  "oneOf":[{"$ref":"#/$defs/claim"},{"$ref":"#/$defs/envelope"},{"$ref":"#/$defs/failure"}],
  "$defs":{
    "identifier":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[!-~]+$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "claim":{"type":"object","additionalProperties":false,"required":["schema_version","request_id","service","broker_id","audience","execution_id","execution_epoch","authority_revision","not_after_millis","operation","selector_sha256","projection_sha256","evidence_schema_sha256","generation_sha256","content_sha256"],"properties":{"schema_version":{"const":2},"request_id":{"$ref":"#/$defs/identifier"},"service":{"const":"confluence"},"broker_id":{"$ref":"#/$defs/identifier"},"audience":{"$ref":"#/$defs/identifier"},"execution_id":{"$ref":"#/$defs/identifier"},"execution_epoch":{"$ref":"#/$defs/identifier"},"authority_revision":{"$ref":"#/$defs/identifier"},"not_after_millis":{"type":"integer","minimum":1},"operation":{"const":"confluence.page.read"},"selector_sha256":{"$ref":"#/$defs/digest"},"projection_sha256":{"$ref":"#/$defs/digest"},"evidence_schema_sha256":{"$ref":"#/$defs/digest"},"generation_sha256":{"$ref":"#/$defs/digest"},"content_sha256":{"$ref":"#/$defs/digest"}}},
    "qualification":{"type":"object","additionalProperties":false,"required":["schema_version","status","issuer_sha256","target_execution_sha256","authority_revision_sha256","request_sha256","issued_at_millis","expires_at_millis"],"properties":{"schema_version":{"const":1},"status":{"enum":["allowed","denied","unavailable"]},"reason":{"type":"string"},"issuer_sha256":{"$ref":"#/$defs/digest"},"target_execution_sha256":{"$ref":"#/$defs/digest"},"authority_revision_sha256":{"$ref":"#/$defs/digest"},"request_sha256":{"$ref":"#/$defs/digest"},"issued_at_millis":{"type":"integer","minimum":1},"expires_at_millis":{"type":"integer","minimum":1}}},
    "envelope":{"type":"object","additionalProperties":false,"required":["schema_version","transport_schema_sha256","claim_sha256","candidate_sha256","target_execution_sha256","authority_revision_sha256","request_sha256","qualification","release_deadline_millis","complete"],"properties":{"schema_version":{"const":2},"transport_schema_sha256":{"$ref":"#/$defs/digest"},"claim_sha256":{"$ref":"#/$defs/digest"},"candidate_sha256":{"$ref":"#/$defs/digest"},"target_execution_sha256":{"$ref":"#/$defs/digest"},"authority_revision_sha256":{"$ref":"#/$defs/digest"},"request_sha256":{"$ref":"#/$defs/digest"},"qualification":{"$ref":"#/$defs/qualification"},"release_deadline_millis":{"type":"integer","minimum":1},"complete":{"const":true}}},
    "failure":{"type":"object","additionalProperties":false,"required":["schema_version","status","reason","recovery","retry_safe","complete"],"properties":{"schema_version":{"const":2},"status":{"const":"rejected"},"reason":{"enum":["unsupported","malformed","denied","revoked","grant_expired","credential_expired","stale_execution","stale_authority","decision_expired","authorization_unavailable"]},"recovery":{"enum":["adjust_request","inspect_failure","reauthenticate","request_access","reread_then_reselect"]},"retry_safe":{"const":false},"complete":{"const":true}}}
  }
}
