{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isukharev/atl/docs/schemas/broker-discovery-v2.schema.json",
  "title": "ATL Broker execution-scoped discovery v2",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/authorization_request"},
    {"$ref": "#/$defs/projection"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "correlation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[!-~]+$"
    },
    "millis": {
      "type": "integer",
      "minimum": 1
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "execution_epoch", "authority_revision"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/id"},
        "execution_epoch": {"$ref": "#/$defs/id"},
        "authority_revision": {"$ref": "#/$defs/id"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "service", "broker_id", "audience", "context_sha256", "not_after_millis", "expect"],
      "properties": {
        "schema_version": {"const": 2},
        "request_id": {"$ref": "#/$defs/id"},
        "service": {"enum": ["jira", "confluence"]},
        "broker_id": {"$ref": "#/$defs/id"},
        "audience": {"$ref": "#/$defs/id"},
        "context_sha256": {"$ref": "#/$defs/digest"},
        "not_after_millis": {"$ref": "#/$defs/millis"},
        "expect": {"$ref": "#/$defs/expect"}
      }
    },
    "authorization_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request", "context", "request_sha256"],
      "properties": {
        "schema_version": {"const": 2},
        "request": {"$ref": "#/$defs/request"},
        "context": {"$ref": "broker-v1.schema.json#/$defs/verified_context"},
        "request_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource_kind", "fields"],
      "properties": {
        "kind": {"enum": ["read", "comment", "observe"]},
        "resource_kind": {"enum": ["jira_issue", "confluence_page", "operation"]},
        "fields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "supported", "access", "features", "limits", "effects"],
      "properties": {
        "id": {"type": "string"},
        "version": {"const": 1},
        "supported": {"const": true},
        "access": {"enum": ["allowed", "access_request_required", "unavailable"]},
        "request_access_correlation": {"$ref": "#/$defs/correlation"},
        "features": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "limits": {"$ref": "broker-v1.schema.json#/$defs/limits"},
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/effect"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"access": {"const": "access_request_required"}}},
          "then": {"required": ["request_access_correlation"]},
          "else": {"not": {"required": ["request_access_correlation"]}}
        }
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "request_id", "request_sha256", "context_sha256",
        "execution_id", "execution_epoch", "audience", "broker_id",
        "authority_revision", "service", "registry_sha256",
        "contract_schema_sha256", "discovery_schema_sha256",
        "issued_at_millis", "expires_at_millis", "operations", "complete"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "request_id": {"$ref": "#/$defs/id"},
        "request_sha256": {"$ref": "#/$defs/digest"},
        "context_sha256": {"$ref": "#/$defs/digest"},
        "execution_id": {"$ref": "#/$defs/id"},
        "execution_epoch": {"$ref": "#/$defs/id"},
        "audience": {"$ref": "#/$defs/id"},
        "broker_id": {"$ref": "#/$defs/id"},
        "authority_revision": {"$ref": "#/$defs/id"},
        "service": {"enum": ["jira", "confluence"]},
        "registry_sha256": {"$ref": "#/$defs/digest"},
        "contract_schema_sha256": {"$ref": "#/$defs/digest"},
        "discovery_schema_sha256": {"$ref": "#/$defs/digest"},
        "issued_at_millis": {"$ref": "#/$defs/millis"},
        "expires_at_millis": {"$ref": "#/$defs/millis"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/operation"}
        },
        "complete": {"const": true}
      }
    }
  }
}
