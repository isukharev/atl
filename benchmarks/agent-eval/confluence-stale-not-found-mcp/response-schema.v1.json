{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confluence_search": {"type": "string", "enum": ["complete"]},
        "confluence_section": {"type": "string", "enum": ["not_found"]}
      },
      "required": ["confluence_search", "confluence_section"]
    },
    "evidence_complete": {"type": "boolean"},
    "decision": {"type": "string", "enum": ["undetermined"]},
    "observed_facts": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "section_claims": {
      "type": "array", "maxItems": 0,
      "items": {"type": "string"}
    },
    "access_limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "no_retry_attempted": {"type": "boolean"},
    "brief": {"type": "string", "minLength": 1}
  },
  "required": [
    "topic", "page_id", "query", "source_status", "evidence_complete",
    "decision", "observed_facts", "section_claims", "access_limitations",
    "no_retry_attempted", "brief"
  ]
}
