{
  "schema_version": 1,
  "id": "confluence.synthetic-comment-routing-mcp-v1",
  "category": "surface-native",
  "task_class": "confluence/comments",
  "description": "Use body-free comment inventory to select one exact thread, propagate the observed page version into the expansion, and preserve each result's explicit completeness without any write or shell route.",
  "data_class": "synthetic",
  "required_capabilities": ["confluence.comment.list", "confluence.comment.thread"],
  "required_checks": ["bounded_interface", "guard_clean", "http_exact", "interface_succeeded", "inventory_complete_exact", "mock_clean", "no_delegation", "page_version_exact", "route_arguments", "route_exact", "route_ordered", "schema_version_exact", "selected_comment_exact", "thread_complete_exact", "thread_text_exact", "used_interface"],
  "required_semantic_checks": ["inventory_complete_exact", "page_version_exact", "schema_version_exact", "selected_comment_exact", "thread_complete_exact", "thread_text_exact"],
  "required_metrics": ["agent_turns", "tool_calls", "interface_invocations", "delegations", "backend_requests", "duplicate_backend_requests", "remote_writes", "output_bytes", "input_tokens", "output_tokens", "main_thread_input_tokens", "main_thread_output_tokens", "estimated_cost_microusd", "duration_millis", "capability_families"],
  "budgets": {
    "max_agent_turns": 6,
    "max_tool_calls": 3,
    "max_atl_invocations": 0,
    "max_interface_invocations": 2,
    "max_delegations": 0,
    "max_backend_requests": 6,
    "max_duplicate_backend_requests": 1,
    "max_remote_writes": 0,
    "max_output_bytes": 65536,
    "max_input_tokens": 150000,
    "max_output_tokens": 8000,
    "max_main_thread_input_tokens": 150000,
    "max_main_thread_output_tokens": 8000,
    "max_estimated_cost_microusd": 6000000,
    "max_duration_millis": 450000,
    "allowed_http_methods": ["GET"]
  }
}
