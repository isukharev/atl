{
  "schema_version": 1,
  "id": "jira.synthetic-artifact-graph-mcp-holdout-v1",
  "category": "surface-native",
  "task_class": "jira/graph-evidence",
  "description": "Read a distinct linked Jira topology through one request-limited typed graph call and preserve its incomplete source qualification and frontier without labels or narrative.",
  "data_class": "synthetic",
  "required_capabilities": ["jira.issue.graph"],
  "required_checks": [
    "bounded_interface", "brief_present", "complete_correct", "content_not_mutated",
    "development_absent", "frontier_correct", "guard_clean", "http_exact",
    "interface_succeeded", "labels_absent", "mock_clean", "narrative_absent",
    "no_delegation", "reconciliation_correct", "root_correct", "route_arguments", "route_exact",
    "route_ordered", "sources_correct", "topology_correct", "truncated_correct",
    "used_interface"
  ],
  "required_semantic_checks": [
    "complete_correct", "content_not_mutated", "development_absent",
    "frontier_correct", "labels_absent", "narrative_absent",
    "reconciliation_correct", "root_correct", "sources_correct", "topology_correct",
    "truncated_correct"
  ],
  "required_metrics": [
    "agent_turns", "tool_calls", "interface_invocations", "delegations",
    "backend_requests", "duplicate_backend_requests", "output_bytes",
    "input_tokens", "output_tokens", "main_thread_input_tokens",
    "main_thread_output_tokens", "estimated_cost_microusd",
    "duration_millis", "capability_families"
  ],
  "budgets": {
    "max_agent_turns": 5,
    "max_tool_calls": 2,
    "max_atl_invocations": 0,
    "max_interface_invocations": 1,
    "max_delegations": 0,
    "max_backend_requests": 4,
    "max_duplicate_backend_requests": 0,
    "max_remote_writes": 0,
    "max_output_bytes": 49152,
    "max_input_tokens": 140000,
    "max_output_tokens": 7000,
    "max_main_thread_input_tokens": 140000,
    "max_main_thread_output_tokens": 7000,
    "max_estimated_cost_microusd": 5500000,
    "max_duration_millis": 540000,
    "allowed_http_methods": ["GET"]
  }
}
