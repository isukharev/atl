{
  "schema_version": 1,
  "id": "jira.synthetic-artifact-graph-development-mcp-v1",
  "category": "surface-native",
  "task_class": "jira/graph-evidence",
  "description": "Read one exact Jira issue through an explicitly opted-in bounded graph call, reconcile closed SCM coordinates, and prepare but do not execute a host-gated downstream read plan.",
  "data_class": "synthetic",
  "required_capabilities": ["jira.issue.graph"],
  "required_checks": [
    "bounded_interface", "brief_present", "complete_correct", "content_not_mutated",
    "coordinates_correct", "development_reconciliation_correct", "development_source_correct",
    "guard_clean", "handoff_correct", "http_exact", "interface_succeeded", "mock_clean",
    "no_delegation", "opt_in_correct", "privacy_correct", "reconciliation_correct",
    "root_correct", "route_arguments", "route_exact", "route_ordered", "topology_correct",
    "truncated_correct", "used_interface"
  ],
  "required_semantic_checks": [
    "complete_correct", "content_not_mutated", "coordinates_correct",
    "development_reconciliation_correct", "development_source_correct", "handoff_correct",
    "opt_in_correct", "privacy_correct", "reconciliation_correct", "root_correct",
    "topology_correct", "truncated_correct"
  ],
  "required_metrics": [
    "agent_turns", "tool_calls", "interface_invocations", "delegations",
    "backend_requests", "duplicate_backend_requests", "output_bytes", "input_tokens",
    "output_tokens", "main_thread_input_tokens", "main_thread_output_tokens",
    "estimated_cost_microusd", "duration_millis", "capability_families"
  ],
  "budgets": {
    "max_agent_turns": 6,
    "max_tool_calls": 2,
    "max_atl_invocations": 0,
    "max_interface_invocations": 1,
    "max_delegations": 0,
    "max_backend_requests": 8,
    "max_duplicate_backend_requests": 0,
    "max_remote_writes": 0,
    "max_output_bytes": 65536,
    "max_input_tokens": 150000,
    "max_output_tokens": 8000,
    "max_main_thread_input_tokens": 150000,
    "max_main_thread_output_tokens": 8000,
    "max_estimated_cost_microusd": 6000000,
    "max_duration_millis": 600000,
    "allowed_http_methods": ["GET"]
  }
}
