{
  "schema_version": 1,
  "id": "confluence.synthetic-attachment-evidence-mcp-v1",
  "category": "surface-native",
  "task_class": "confluence/evidence",
  "description": "Qualify one attachment reference found in a complete bounded Confluence section against the page's separately timed metadata-only attachment inventory after a pre-list check confirms the page still has the observed version, then report current membership without treating the two reads as an atomic snapshot, reading attachment bytes, inferring file contents, or settling the position the page defers.",
  "data_class": "synthetic",
  "required_capabilities": ["confluence.attachment.list", "confluence.page.section"],
  "required_checks": [
    "attachment_exact",
    "bounded_interface",
    "brief_present",
    "bytes_unread_exact",
    "content_absent_exact",
    "decision_exact",
    "file_size_exact",
    "guard_clean",
    "heading_exact",
    "http_exact",
    "interface_succeeded",
    "inventory_complete_exact",
    "inventory_count_exact",
    "membership_exact",
    "mock_clean",
    "no_delegation",
    "page_id_exact",
    "page_version_exact",
    "route_arguments",
    "route_exact",
    "route_ordered",
    "schema_version_exact",
    "used_interface"
  ],
  "required_semantic_checks": [
    "attachment_exact",
    "brief_present",
    "bytes_unread_exact",
    "content_absent_exact",
    "decision_exact",
    "file_size_exact",
    "heading_exact",
    "inventory_complete_exact",
    "inventory_count_exact",
    "membership_exact",
    "page_id_exact",
    "page_version_exact",
    "schema_version_exact"
  ],
  "required_metrics": [
    "agent_turns",
    "tool_calls",
    "interface_invocations",
    "delegations",
    "backend_requests",
    "duplicate_backend_requests",
    "output_bytes",
    "input_tokens",
    "output_tokens",
    "main_thread_input_tokens",
    "main_thread_output_tokens",
    "estimated_cost_microusd",
    "duration_millis",
    "capability_families"
  ],
  "budgets": {
    "max_agent_turns": 6,
    "max_tool_calls": 3,
    "max_atl_invocations": 0,
    "max_interface_invocations": 2,
    "max_delegations": 0,
    "max_backend_requests": 3,
    "max_duplicate_backend_requests": 0,
    "max_remote_writes": 0,
    "max_output_bytes": 65536,
    "max_input_tokens": 150000,
    "max_output_tokens": 8000,
    "max_main_thread_input_tokens": 150000,
    "max_main_thread_output_tokens": 8000,
    "max_estimated_cost_microusd": 6000000,
    "max_duration_millis": 450000,
    "allowed_http_methods": ["GET"]
  }
}
