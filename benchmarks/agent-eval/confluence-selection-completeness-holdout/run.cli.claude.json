{
  "schema_version": 6,
  "scenario_file": "scenario.v1.json",
  "category": "surface-native",
  "surface": "cli-skill",
  "provider": "claude-code",
  "variant": "confluence-selection-completeness-v1",
  "model": "claude-opus-4-8",
  "reasoning": "high",
  "prompt_file": "prompt.claude.v1.md",
  "response_schema_file": "response-schema.v1.json",
  "qualitative_rubric_file": "rubric.v1.json",
  "workspace_template": "workspace",
  "fixture_file": "fixture.json",
  "repetitions": 1,
  "timeout_seconds": 600,
  "max_estimated_cost_microusd": 10000000,
  "pricing": {"input_microusd_per_million_tokens": 5000000, "output_microusd_per_million_tokens": 25000000},
  "allowed_tools": ["Bash(atl *)", "Skill"],
  "allowed_atl_commands": [
    "atl conf search --cql 'space = \"ARCHIVE\" AND type = page' --limit 25 --"
  ],
  "checks": [
    {"name":"absence_claim_rejected","kind":"json_equals","pointer":"/absence_claim_supported","expected":false},
    {"name":"atl_succeeded","kind":"atl_all_succeeded"},
    {"name":"complete_correct","kind":"json_equals","pointer":"/complete","expected":false},
    {"name":"count_correct","kind":"json_equals","pointer":"/observed_count","expected":2},
    {"name":"guard_clean","kind":"guard_no_denials"},
    {"name":"http_exact","kind":"http_methods_equal","expected":{"GET":1}},
    {"name":"local_mirror_correct","kind":"json_equals","pointer":"/local_mirror_written","expected":false},
    {"name":"mock_clean","kind":"mock_no_unexpected"},
    {"name":"no_delegation","kind":"delegations_none"},
    {"name":"no_remote_writes","kind":"json_equals","pointer":"/remote_writes_performed","expected":false},
    {"name":"operation_correct","kind":"json_equals","pointer":"/operation","expected":"search"},
    {"name":"partial_reason_correct","kind":"json_equals","pointer":"/partial_reason","expected":"backend reported 5 total matches but only 2 were reachable"},
    {"name":"query_correct","kind":"json_equals","pointer":"/query","expected":"space = \"ARCHIVE\" AND type = page"},
    {"name":"remediation_correct","kind":"json_equals","pointer":"/recommended_action","expected":"refine-or-investigate"},
    {"name":"selection_only","kind":"json_equals","pointer":"/selection_only","expected":true},
    {"name":"truncated_at_correct","kind":"json_equals","pointer":"/truncated_at","expected":null},
    {"name":"truncated_correct","kind":"json_equals","pointer":"/truncated","expected":true},
    {"name":"unobserved_possible","kind":"json_equals","pointer":"/unobserved_matches_possible","expected":true},
    {"name":"used_atl","kind":"atl_invocations_min","minimum":1},
    {"name":"used_atl_once","kind":"atl_invocations_max","maximum":1},
    {"name":"used_skill","kind":"skill_invocations_min","minimum":1,"expected":"atl:confluence"},
    {"name":"warning_observed","kind":"json_equals","pointer":"/warning_observed","expected":false}
  ]
}
