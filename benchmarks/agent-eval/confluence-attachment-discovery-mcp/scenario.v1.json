{
  "schema_version": 1,
  "id": "confluence.synthetic-attachment-discovery-mcp-v1",
  "category": "surface-native",
  "task_class": "confluence/attachment-discovery",
  "description": "Decide one filename's membership from a complete caller-bounded global attachment-metadata prefix without reading bytes or following links.",
  "data_class": "synthetic",
  "required_capabilities": ["confluence.attachment.search"],
  "required_checks": ["absence_correct", "bounded_interface", "complete_correct", "count_correct", "guard_clean", "http_exact", "interface_succeeded", "mock_clean", "no_delegation", "qualification_correct", "route_arguments", "route_exact", "schema_version_exact", "used_interface"],
  "required_semantic_checks": ["absence_correct", "complete_correct", "count_correct", "qualification_correct", "schema_version_exact"],
  "required_metrics": ["agent_turns", "tool_calls", "interface_invocations", "delegations", "backend_requests", "duplicate_backend_requests", "remote_writes", "output_bytes", "input_tokens", "output_tokens", "main_thread_input_tokens", "main_thread_output_tokens", "estimated_cost_microusd", "duration_millis", "capability_families"],
  "budgets": {
    "max_agent_turns": 5,
    "max_tool_calls": 2,
    "max_atl_invocations": 0,
    "max_interface_invocations": 1,
    "max_delegations": 0,
    "max_backend_requests": 1,
    "max_duplicate_backend_requests": 0,
    "max_remote_writes": 0,
    "max_output_bytes": 32768,
    "max_input_tokens": 120000,
    "max_output_tokens": 4000,
    "max_main_thread_input_tokens": 120000,
    "max_main_thread_output_tokens": 4000,
    "max_estimated_cost_microusd": 4000000,
    "max_duration_millis": 300000,
    "allowed_http_methods": ["GET"]
  }
}
