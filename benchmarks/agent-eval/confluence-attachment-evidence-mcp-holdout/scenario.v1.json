{
  "schema_version": 1,
  "id": "confluence.synthetic-attachment-evidence-mcp-holdout-v1",
  "category": "surface-native",
  "task_class": "confluence/evidence",
  "description": "Qualify one attachment reference found in a complete bounded Confluence section against a separately timed complete metadata-only attachment inventory after a pre-list version check, then report the reference as currently dangling only because the inventory proved exhaustive, without treating the reads as atomic, retrying, broadening the bound, reading attachment bytes, or inferring the contents of a file that is not there.",
