  "required_checks": [
    "attachment_exact",
    "bounded_interface",
    "brief_present",
    "bytes_unread_exact",
    "content_absent_exact",
    "decision_exact",
    "file_size_exact",
    "guard_clean",
    "heading_exact",
    "http_exact",
    "interface_succeeded",
    "inventory_complete_exact",
    "inventory_count_exact",
    "membership_exact",
    "mock_clean",
    "no_delegation",
    "page_id_exact",
    "page_version_exact",
    "route_arguments",
    "route_exact",
    "route_ordered",
    "schema_version_exact",
    "used_interface"
  ],
  "required_semantic_checks": [
    "attachment_exact",
