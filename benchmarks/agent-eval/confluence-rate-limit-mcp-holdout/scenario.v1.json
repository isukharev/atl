{
  "schema_version": 1,
  "id": "confluence.synthetic-rate-limit-mcp-holdout",
  "category": "surface-native",
  "task_class": "knowledge/search",
  "description": "Hold out a distinct exhausted bounded Confluence search rate limit without an additional agent-level request or claims from unavailable content.",
  "data_class": "synthetic",
  "required_capabilities": ["knowledge.confluence.search"],
  "required_checks": [
    "access_qualified", "bounded_interface", "brief_present", "decision_undetermined",
    "evidence_incomplete", "expected_failure", "facts_present", "guard_clean",
    "http_exact", "mock_clean", "no_agent_retry", "no_delegation", "query_exact",
    "route_arguments", "route_exact", "route_ordered", "source_claims_empty",
    "source_status_exact", "topic_correct", "used_interface"
  ],
  "required_semantic_checks": [
    "access_qualified", "brief_present", "decision_undetermined",
    "evidence_incomplete", "facts_present", "no_agent_retry", "query_exact",
    "source_claims_empty", "source_status_exact", "topic_correct"
  ],
  "required_metrics": [
    "agent_turns", "tool_calls", "interface_invocations", "delegations",
    "backend_requests", "duplicate_backend_requests", "output_bytes",
    "input_tokens", "output_tokens", "main_thread_input_tokens",
    "main_thread_output_tokens", "estimated_cost_microusd",
    "duration_millis", "capability_families"
  ],
  "budgets": {
    "max_agent_turns": 5,
    "max_tool_calls": 2,
    "max_atl_invocations": 0,
    "max_interface_invocations": 1,
    "max_delegations": 0,
    "max_backend_requests": 4,
    "max_duplicate_backend_requests": 3,
    "max_remote_writes": 0,
    "max_output_bytes": 32768,
    "max_input_tokens": 150000,
    "max_output_tokens": 8000,
    "max_main_thread_input_tokens": 150000,
    "max_main_thread_output_tokens": 8000,
    "max_estimated_cost_microusd": 6000000,
    "max_duration_millis": 450000,
    "allowed_http_methods": ["GET"]
  }
}
