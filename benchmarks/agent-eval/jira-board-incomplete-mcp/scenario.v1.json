{
  "schema_version": 1,
  "id": "jira.synthetic-board-incomplete-mcp-v1",
  "category": "surface-native",
  "task_class": "knowledge/search",
  "description": "Qualify an intentionally bounded partial Jira board/backlog snapshot without overclaiming observed membership as complete totals or retrying beyond the reviewed limit.",
  "data_class": "synthetic",
  "required_capabilities": ["knowledge.jira.search"],
  "required_checks": [
    "backlog_fetched", "board_identity", "bounded_interface", "brief_present", "complete",
    "counts_observed_only", "embedded_content_safe", "guard_clean", "http_exact",
    "identity_order", "incomplete_qualified", "interface_succeeded",
    "membership_correct", "mock_clean", "no_delegation", "no_retry",
    "projection_correct", "query_exact", "requested_limit_correct", "route_arguments", "route_exact",
    "route_ordered", "row_count_correct", "scope_correct", "truncated", "used_interface"
  ],
  "required_semantic_checks": [
    "backlog_fetched", "board_identity", "complete", "counts_observed_only",
    "embedded_content_safe", "identity_order", "incomplete_qualified",
    "membership_correct", "no_retry", "projection_correct", "query_exact",
    "requested_limit_correct", "row_count_correct", "scope_correct", "truncated"
  ],
  "required_metrics": [
    "agent_turns", "tool_calls", "interface_invocations", "delegations",
    "backend_requests", "duplicate_backend_requests", "output_bytes",
    "input_tokens", "output_tokens", "main_thread_input_tokens",
    "main_thread_output_tokens", "estimated_cost_microusd",
    "duration_millis", "capability_families"
  ],
  "budgets": {
    "max_agent_turns": 5,
    "max_tool_calls": 2,
    "max_atl_invocations": 0,
    "max_interface_invocations": 1,
    "max_delegations": 0,
    "max_backend_requests": 3,
    "max_duplicate_backend_requests": 0,
    "max_remote_writes": 0,
    "max_output_bytes": 131072,
    "max_input_tokens": 150000,
    "max_output_tokens": 12000,
    "max_main_thread_input_tokens": 150000,
    "max_main_thread_output_tokens": 12000,
    "max_estimated_cost_microusd": 10000000,
    "max_duration_millis": 600000,
    "allowed_http_methods": ["GET"]
  }
}
