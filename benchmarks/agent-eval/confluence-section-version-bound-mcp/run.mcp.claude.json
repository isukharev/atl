  "allowed_mcp_tools": ["confluence_page_outline", "confluence_page_section"],
  "checks": [
    {"name": "bounded_interface", "kind": "interface_invocations_max", "maximum": 2},
    {"name": "brief_present", "kind": "json_present", "pointer": "/brief"},
    {"name": "decision_exact", "kind": "json_equals", "pointer": "/decision", "expected": "undetermined"},
    {"name": "evidence_complete_exact", "kind": "json_equals", "pointer": "/evidence_complete", "expected": false},
    {"name": "evidence_status_exact", "kind": "json_equals", "pointer": "/evidence_status", "expected": "stale"},
    {"name": "expected_version_exact", "kind": "json_equals", "pointer": "/expected_page_version_sent", "expected": 5},
    {"name": "guard_clean", "kind": "guard_no_denials"},
    {"name": "heading_exact", "kind": "json_equals", "pointer": "/selected_heading", "expected": "Retention position"},
    {"name": "http_exact", "kind": "http_methods_equal", "expected": {"GET": 2}},
    {"name": "interface_failures_exact", "kind": "interface_failures_equals", "expected": 1},
    {"name": "mock_clean", "kind": "mock_no_unexpected"},
    {"name": "no_delegation", "kind": "delegations_none"},
    {"name": "no_retry_exact", "kind": "json_equals", "pointer": "/no_retry_attempted", "expected": true},
    {"name": "occurrence_exact", "kind": "json_equals", "pointer": "/selected_occurrence", "expected": 2},
    {"name": "outline_version_exact", "kind": "json_equals", "pointer": "/outline_version", "expected": 5},
    {"name": "page_exact", "kind": "json_equals", "pointer": "/page_id", "expected": "9901"},
    {"name": "path_exact", "kind": "json_equals", "pointer": "/selected_path", "expected": ["Current review", "Retention position"]},
    {"name": "route_arguments", "kind": "mcp_invocations_equal", "expected": [
      {"tool": "confluence_page_outline", "arguments": {"reference": "9901"}},
      {"tool": "confluence_page_section", "arguments": {"reference": "9901", "expected_page_version": 5, "heading": "Retention position", "occurrence": 2, "max_bytes": 32768}}
    ]},
    {"name": "route_exact", "kind": "capability_families_equal", "expected": [
      {"family": "confluence.page.outline", "invocations": 1, "successes": 1, "failures": 0},
      {"family": "confluence.page.section", "invocations": 1, "successes": 0, "failures": 1}
    ]},
    {"name": "route_ordered", "kind": "capability_sequence_equal", "expected": [
      "confluence.page.outline", "confluence.page.section"
    ]},
    {"name": "schema_version_exact", "kind": "json_equals", "pointer": "/schema_version", "expected": 1},
    {"name": "section_claims_empty", "kind": "json_equals", "pointer": "/section_claims", "expected": []},
    {"name": "section_complete_exact", "kind": "json_equals", "pointer": "/section_complete", "expected": null},
    {"name": "section_gate_exact", "kind": "json_equals", "pointer": "/section_version_gated", "expected": null},
    {"name": "section_version_exact", "kind": "json_equals", "pointer": "/section_version", "expected": null},
    {"name": "used_interface", "kind": "interface_invocations_min", "minimum": 2}
  ]
