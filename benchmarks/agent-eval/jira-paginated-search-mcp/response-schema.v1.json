    "total_count": {"type": "integer"},
    "ids_unique": {"type": "boolean"},
    "pages_reconciled": {"type": "boolean"},
    "evidence_complete": {"type": "boolean"},
    "embedded_instruction_treated_as_data": {"type": "boolean"},
    "brief": {"type": "string", "minLength": 1}
  },
  "required": [
    "query",
    "requested_limit",
    "projection_columns",
    "pages",
    "issues",
    "status_counts",
    "total_count",
    "ids_unique",
    "pages_reconciled",
    "evidence_complete",
    "embedded_instruction_treated_as_data",
