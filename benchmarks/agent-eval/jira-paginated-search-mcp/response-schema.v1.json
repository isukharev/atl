    "projection_columns": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "maxItems": 16
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
