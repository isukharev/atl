        "properties": {
          "cursor": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "keys": {"type": "array", "items": {"type": "string"}},
          "count": {"type": "integer"},
          "complete": {"type": "boolean"},
          "truncated": {"type": "boolean"},
          "next_cursor": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        },
        "required": ["cursor", "keys", "count", "complete", "truncated", "next_cursor"]
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "status": {"type": "string"},
          "updated": {"type": "string"}
        },
        "required": ["key", "status", "updated"]
      }
    },
    "status_counts": {
      "type": "object",
      "properties": {
        "Blocked": {"type": "integer"},
        "Closed": {"type": "integer"},
        "Done": {"type": "integer"},
